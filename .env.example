# Copy these into Vercel (Project Settings > Environment Variables).
# Never commit real values. Real .env files are gitignored.

# --- Server-side only (serverless functions in api/) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # bypasses RLS; never expose to the browser
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=          # from the Resend webhook settings (svix signing secret)
CRON_SECRET=                    # authorizes the scheduled reminder run
DEEPL_API_KEY=                  # free-tier keys end in :fx
SITE_URL=https://clinic.example.org   # where invite links land

# --- Browser (Vite) variables: baked into the public bundle ---
# The anon key is public by design; Row Level Security is what protects the data.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_VET_LICENSE_VALBUENA=      # license number printed on rabies certificates
